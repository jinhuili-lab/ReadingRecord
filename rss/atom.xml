        <content type="html"><![CDATA[<div id="notion-article" class="mx-auto overflow-hidden "><main class="notion light-mode notion-page notion-block-3f7bb80433938064ab87db36cb670050"><div class="notion-viewport"></div><div class="notion-collection-page-properties"></div><div class="notion-text notion-block-3f7bb8043393800a9d45f269bb50c32e">The raw resource:  <a class="notion-link" href="https://github.com/eternity4719/HowToLiveBetter" target="_blank" rel="noopener noreferrer">https://github.com/eternity4719/HowToLiveBetter</a></div><div class="notion-text notion-block-3f7bb8043393807f90e0e53150e90dfc">Download: <div class="notion-text-children"><div class="notion-file notion-block-3f7bb804339380238ce3c7d6d803da26"><a class="notion-file-link" href="https://raw.githubusercontent.com/jinhuili-lab/personal_image_bed/8ab52855489032d5b49ab549489558948f4a33a0/forMD/%E9%AB%98%E6%80%A7%E4%BB%B7%E6%AF%94%E4%BA%BA%E7%94%9F%E6%8C%87%E5%8D%97.pdf?spaceId=2222cc6d-b216-4bca-b86d-801820c904e8" target="_blank" rel="noopener noreferrer"><svg class="notion-file-icon" viewBox="0 0 30 30"><path d="M22,8v12c0,3.866-3.134,7-7,7s-7-3.134-7-7V8c0-2.762,2.238-5,5-5s5,2.238,5,5v12c0,1.657-1.343,3-3,3s-3-1.343-3-3V8h-2v12c0,2.762,2.238,5,5,5s5-2.238,5-5V8c0-3.866-3.134-7-7-7S6,4.134,6,8v12c0,4.971,4.029,9,9,9s9-4.029,9-9V8H22z"></path></svg><div class="notion-file-info"><div class="notion-file-title">高性价比人生指南.pdf</div></div></a></div></div></div><figure class="notion-asset-wrapper notion-asset-wrapper-embed"><div style="height:798.9912719726562px;position:relative"><iframe class="notion-asset-object-fit" src="https://cdyforever.github.io/how-to-live-better/" title="iframe embed" frameBorder="0" loading="lazy" scrolling="auto" allowfullscreen=""></iframe></div></figure></main></div>]]></content>
